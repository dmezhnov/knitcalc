{
    "name": {
        "ru": "Прямоугольный шарф",
        "en": "Rectangular scarf"
    },
    "include": ["gauge"],
    "inputs": [
        {
            "key": "targetWidthCm",
            "label": {
                "ru": "Желаемая ширина (см)",
                "en": "Desired width (cm)"
            }
        },
        {
            "key": "targetLengthCm",
            "label": {
                "ru": "Желаемая длина (см)",
                "en": "Desired length (cm)"
            }
        },
        {
            "key": "sampleWidthStitches",
            "label": {
                "ru": "Петель в распущенном ряду",
                "en": "Stitches in the unravelled row"
            },
            "allowDecimal": false,
            "hint": {
                "ru": "Распустите один ряд образца и посчитайте, сколько в нём было петель",
                "en": "Unravel one row of the swatch and count the stitches it held"
            }
        },
        {
            "key": "sampleThreadLengthCm",
            "label": {
                "ru": "Длина нити этого ряда (см)",
                "en": "Yarn in that row (cm)"
            }
        }
    ],
    "values": {
        "threadLengthPerStitch": "sampleThreadLengthCm / sampleWidthStitches",
        "targetStitches": "stitchesPerCm * targetWidthCm",
        "targetRows": "rowsPerCm * targetLengthCm"
    },
    "outputs": [
        {
            "key": "targetStitches",
            "label": {
                "ru": "Желаемое количество петель",
                "en": "Desired stitch count"
            },
            "value": "targetStitches"
        },
        {
            "key": "targetRows",
            "label": {
                "ru": "Желаемое количество рядов",
                "en": "Desired row count"
            },
            "value": "targetRows"
        },
        {
            "key": "targetThreadLength",
            "label": {
                "ru": "Длина нити на шарф (м)",
                "en": "Yarn for the scarf (m)"
            },
            "value": "threadLengthPerStitch * targetStitches * targetRows / 100"
        }
    ]
}
